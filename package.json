        .foot a:hover { color: var(--text2); }

        /* ===== RESPONSIVE ===== */
        @media (max-width: 640px) {
            .nav, .main, .foot { padding-left: 20px; padding-right: 20px; }
            .hero-content { padding: 36px 20px 40px; }
            .hero-title { font-size: 1.5rem; }
            .qris-content { flex-direction: column; text-align: center; }
