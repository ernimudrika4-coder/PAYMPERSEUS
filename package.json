        }
        .summary-row .label { color: var(--text2); }
        .summary-row .value { font-weight: 600; font-family: 'JetBrains Mono', monospace; font-size: 0.82rem; }
        .summary-row.total { border-top: 1px solid var(--border); margin-top: 8px; padding-top: 12px; }
        .summary-row.total .value { color: var(--green); font-size: 0.95rem; font-weight: 800; }

        /* ===== TOAST ===== */
        .toast {
            position: fixed; bottom: 30px; left: 50%; z-index: 9999;
            background: var(--surface2); border: 1px solid var(--border);
            backdrop-filter: blur(20px);
            color: var(--text); padding: 12px 22px; border-radius: 12px;
            font-size: 0.82rem; font-weight: 600;
            display: flex; align-items: center; gap: 8px;
            transform: translate(-50%, 100px); opacity: 0;
            transition: all 0.4s cubic-bezier(0.16,1,0.3,1);
            box-shadow: 0 16px 50px rgba(0,0,0,0.5);
        }
        .toast.show { transform: translate(-50%, 0); opacity: 1; }

        /* ===== FOOTER ===== */
        .foot {
            width: 100%; max-width: 580px;
            padding: 0 0 30px;
            display: flex; justify-content: center; gap: 20px;
            font-size: 0.72rem; color: var(--text3);
            position: relative; z-index: 10;
        }
