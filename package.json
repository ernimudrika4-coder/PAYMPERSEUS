<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Perseus Trade — Access</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap');

        :root {
            --bg: #07080c;
            --surface: #0d0f15;
            --surface2: #12141c;
            --border: rgba(255,255,255,0.06);
            --border-h: rgba(139,92,246,0.3);
            --accent: #8b5cf6;
            --accent2: #a78bfa;
            --cyan: #22d3ee;
            --green: #34d399;
            --gold: #fbbf24;
            --text: #f1f5f9;
            --text2: #64748b;
            --text3: #334155;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        html { scroll-behavior: smooth; }

        body {
            font-family: 'Inter', -apple-system, system-ui, sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            -webkit-font-smoothing: antialiased;
            position: relative;
            overflow-x: hidden;
        }

        /* ===== AMBIENT LIGHT ===== */
        body::before {
            content: '';
            position: fixed; top: -200px; left: 50%; transform: translateX(-50%);
            width: 800px; height: 500px;
            background: radial-gradient(ellipse, rgba(139,92,246,0.08) 0%, rgba(34,211,238,0.03) 40%, transparent 70%);
            pointer-events: none; z-index: 0;
        }
        body::after {
            content: '';
            position: fixed; bottom: -200px; left: 50%; transform: translateX(-50%);
            width: 600px; height: 400px;
            background: radial-gradient(ellipse, rgba(34,211,238,0.05) 0%, transparent 60%);
            pointer-events: none; z-index: 0;
        }

        /* ===== NOISE ===== */
        .noise {
            position: fixed; inset: 0; z-index: 9999; pointer-events: none; opacity: 0.02;
            background: url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
        }

        /* ===== NAV ===== */
        .nav {
            width: 100%; max-width: 580px;
            padding: 24px 0 0;
            display: flex; justify-content: space-between; align-items: center;
            position: relative; z-index: 10;
        }
        .nav-brand {
            display: flex; align-items: center; gap: 10px;
            font-weight: 800; font-size: 1rem; letter-spacing: -0.5px;
        }
        .nav-icon {
            width: 32px; height: 32px; border-radius: 8px;
            background: linear-gradient(135deg, var(--accent), var(--cyan));
            display: flex; align-items: center; justify-content: center;
        }
        .nav-icon svg { width: 16px; height: 16px; fill: #fff; }
        .nav-back {
            font-size: 0.8rem; color: var(--text2);
            display: flex; align-items: center; gap: 4px;
            transition: color 0.2s; cursor: pointer;
            background: none; border: none; font-family: inherit;
        }
        .nav-back:hover { color: var(--text); }

        /* ===== MAIN CONTAINER ===== */
        .main {
            width: 100%; max-width: 580px;
            padding: 40px 0 60px;
            position: relative; z-index: 10;
        }

        /* ===== HERO CARD ===== */
        .hero-card {
            border-radius: 24px;
            padding: 0;
            text-align: center;
            position: relative;
            overflow: hidden;
            background: transparent;
            border: 1px solid rgba(139,92,246,0.15);
            perspective: 800px;
        }

        /* 3D Canvas BG */
        .hero-canvas {
            position: absolute; inset: 0; z-index: 0;
            background:
                radial-gradient(ellipse at 25% 30%, rgba(139,92,246,0.18) 0%, transparent 50%),
                radial-gradient(ellipse at 75% 70%, rgba(34,211,238,0.12) 0%, transparent 50%),
                radial-gradient(ellipse at 50% 50%, rgba(99,102,241,0.06) 0%, transparent 60%),
                linear-gradient(160deg, #0c0e18 0%, #090b12 100%);
        }

        /* Animated grid floor */
        .hero-grid {
            position: absolute; bottom: -40px; left: -20%; right: -20%;
            height: 100px; z-index: 1;
            background:
                linear-gradient(90deg, rgba(139,92,246,0.08) 1px, transparent 1px),
                linear-gradient(0deg, rgba(139,92,246,0.06) 1px, transparent 1px);
            background-size: 40px 20px;
            transform: perspective(300px) rotateX(55deg);
            mask-image: linear-gradient(to top, rgba(0,0,0,0.5), transparent);
            -webkit-mask-image: linear-gradient(to top, rgba(0,0,0,0.5), transparent);
            animation: gridScroll 8s linear infinite;
        }
        @keyframes gridScroll {
            0% { background-position: 0 0; }
            100% { background-position: 0 200px; }
        }

        /* Floating orbs */
        .hero-orb {
            position: absolute; border-radius: 50%; z-index: 1;
            filter: blur(1px);
        }
        .hero-orb-1 {
            width: 6px; height: 6px; background: var(--accent2);
            top: 25%; left: 12%;
            animation: orbFloat1 6s ease-in-out infinite;
            box-shadow: 0 0 15px var(--accent), 0 0 40px rgba(139,92,246,0.3);
        }
        .hero-orb-2 {
            width: 4px; height: 4px; background: var(--cyan);
            top: 35%; right: 15%;
            animation: orbFloat2 7s ease-in-out infinite 1s;
            box-shadow: 0 0 12px var(--cyan), 0 0 30px rgba(34,211,238,0.3);
        }
        .hero-orb-3 {
            width: 5px; height: 5px; background: var(--green);
            bottom: 40%; left: 20%;
            animation: orbFloat3 8s ease-in-out infinite 2s;
            box-shadow: 0 0 12px var(--green), 0 0 30px rgba(52,211,153,0.2);
        }
        .hero-orb-4 {
            width: 3px; height: 3px; background: var(--gold);
            top: 20%; right: 25%;
            animation: orbFloat1 5s ease-in-out infinite 0.5s;
            box-shadow: 0 0 10px var(--gold);
        }
        .hero-orb-5 {
            width: 4px; height: 4px; background: #f472b6;
            bottom: 30%; right: 12%;
            animation: orbFloat2 9s ease-in-out infinite 3s;
            box-shadow: 0 0 12px #f472b6;
        }
        @keyframes orbFloat1 {
            0%,100% { transform: translate(0,0) scale(1); opacity: 0.8; }
            25% { transform: translate(15px,-20px) scale(1.3); opacity: 1; }
            50% { transform: translate(-10px,-35px) scale(0.8); opacity: 0.5; }
            75% { transform: translate(20px,-15px) scale(1.1); opacity: 0.9; }
        }
        @keyframes orbFloat2 {
            0%,100% { transform: translate(0,0) scale(1); opacity: 0.7; }
            33% { transform: translate(-20px,15px) scale(1.4); opacity: 1; }
            66% { transform: translate(15px,-25px) scale(0.7); opacity: 0.4; }
        }
        @keyframes orbFloat3 {
            0%,100% { transform: translate(0,0); opacity: 0.6; }
            50% { transform: translate(25px,-20px); opacity: 1; }
        }

        /* Connection lines */
        .hero-lines {
            position: absolute; inset: 0; z-index: 1;
            overflow: hidden; pointer-events: none;
        }
        .hero-lines svg { width: 100%; height: 100%; }
        .hero-line {
            stroke: rgba(139,92,246,0.12);
            stroke-width: 0.5;
            fill: none;
            stroke-dasharray: 6 8;
            animation: lineDash 4s linear infinite;
        }
        .hero-line-2 {
            stroke: rgba(34,211,238,0.08);
            animation-delay: -2s;
            animation-duration: 6s;
        }
        @keyframes lineDash {
            0% { stroke-dashoffset: 0; }
            100% { stroke-dashoffset: -50; }
        }

        /* Glowing ring */
        .hero-ring {
            position: absolute;
            top: 50%; left: 50%;
            width: 180px; height: 180px;
            transform: translate(-50%, -50%);
            border-radius: 50%;
            border: 1px solid rgba(139,92,246,0.1);
            z-index: 1;
            animation: ringPulse 4s ease-in-out infinite;
        }
        .hero-ring::after {
            content: '';
            position: absolute; inset: -20px;
            border-radius: 50%;
            border: 1px solid rgba(34,211,238,0.06);
            animation: ringPulse 4s ease-in-out infinite 1s;
        }
        @keyframes ringPulse {
            0%,100% { transform: translate(-50%,-50%) scale(1); opacity: 0.4; }
            50% { transform: translate(-50%,-50%) scale(1.15); opacity: 0.8; }
        }

        /* Shield icon center */
        .hero-shield {
            position: relative; z-index: 5;
            width: 56px; height: 56px;
            margin: 0 auto 20px;
            display: flex; align-items: center; justify-content: center;
        }
        .hero-shield-glow {
            position: absolute; inset: -8px;
            border-radius: 16px;
            background: radial-gradient(circle, rgba(139,92,246,0.25), transparent 70%);
            animation: shieldGlow 3s ease-in-out infinite;
        }
        @keyframes shieldGlow {
            0%,100% { opacity: 0.5; transform: scale(1); }
            50% { opacity: 1; transform: scale(1.2); }
        }
        .hero-shield-inner {
            width: 56px; height: 56px; border-radius: 16px;
            background: linear-gradient(135deg, rgba(139,92,246,0.3), rgba(34,211,238,0.15));
            border: 1px solid rgba(139,92,246,0.3);
            display: flex; align-items: center; justify-content: center;
            backdrop-filter: blur(10px);
            position: relative; z-index: 2;
        }
        .hero-shield-inner svg {
            width: 28px; height: 28px;
            fill: none; stroke: #fff; stroke-width: 1.5;
            filter: drop-shadow(0 0 8px rgba(139,92,246,0.5));
        }

        /* Content */
        .hero-content {
            position: relative; z-index: 5;
            padding: 48px 40px 52px;
        }

        .hero-label {
            display: inline-flex; align-items: center; gap: 8px;
            font-size: 0.6rem; font-weight: 700; text-transform: uppercase;
            letter-spacing: 4px; color: var(--accent2);
            margin-bottom: 20px;
            background: rgba(139,92,246,0.08);
            border: 1px solid rgba(139,92,246,0.12);
            padding: 6px 16px; border-radius: 50px;
        }
        .hero-label .dot {
            width: 5px; height: 5px; border-radius: 50%;
            background: var(--green);
            box-shadow: 0 0 8px var(--green);
            animation: pulse 2s infinite;
        }
        @keyframes pulse { 0%,100%{ opacity:1; } 50%{ opacity:0.3; } }

        .hero-title {
            font-size: 2rem; font-weight: 900; letter-spacing: -1.5px;
            margin-bottom: 10px;
            color: #fff;
            text-shadow: 0 0 40px rgba(139,92,246,0.3), 0 2px 10px rgba(0,0,0,0.5);
            line-height: 1.2;
        }
        .hero-title .vip {
            background: linear-gradient(135deg, var(--accent2), var(--cyan), var(--gold));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            background-size: 200% 200%;
            animation: vipShimmer 3s ease infinite;
        }
        @keyframes vipShimmer {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }

        .hero-sub {
            font-size: 0.85rem; color: var(--text2); font-weight: 400;
            letter-spacing: 0.3px;
        }

        /* Top shimmer line */
        .hero-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px;
            background: linear-gradient(90deg, transparent, rgba(139,92,246,0.6), rgba(34,211,238,0.4), transparent);
            z-index: 10;
        }
        /* Bottom shimmer */
        .hero-card::after {
            content: ''; position: absolute; bottom: 0; left: 20%; right: 20%; height: 1px;
            background: linear-gradient(90deg, transparent, rgba(34,211,238,0.2), transparent);
            z-index: 10;
        }

        /* ===== LIVE ACTIVITY BAR ===== */
        .live-bar {
            display: flex; align-items: center; justify-content: center; gap: 8px;
            background: rgba(139,92,246,0.06);
            border: 1px solid rgba(139,92,246,0.1);
            border-radius: 12px; padding: 10px 20px;
            margin-top: 20px; font-size: 0.75rem; color: var(--text2);
            animation: fadeUp 0.6s ease 0.5s both;
        }
        .live-bar .live-dot {
            width: 6px; height: 6px; border-radius: 50%;
            background: #ef4444; box-shadow: 0 0 8px #ef4444;
            animation: pulse 1.5s infinite;
        }
        .live-bar .count {
            font-family: 'JetBrains Mono', monospace;
            font-weight: 700; color: var(--cyan);
        }

        /* ===== URGENCY BANNER ===== */
        .urgency {
            background: linear-gradient(135deg, rgba(251,191,36,0.08), rgba(239,68,68,0.06));
            border: 1px solid rgba(251,191,36,0.15);
            border-radius: 14px; padding: 16px 20px;
            display: flex; align-items: center; gap: 14px;
            margin-top: 24px;
            animation: fadeUp 0.6s ease 0.6s both;
        }
        .urgency-icon {
            font-size: 1.5rem; flex-shrink: 0;
        }
        .urgency-text { flex: 1; }
        .urgency-title {
            font-size: 0.82rem; font-weight: 700; color: var(--gold);
            margin-bottom: 2px;
        }
        .urgency-sub { font-size: 0.72rem; color: var(--text2); }
        .urgency-timer {
            font-family: 'JetBrains Mono', monospace;
            font-size: 1.1rem; font-weight: 800; color: #ef4444;
            flex-shrink: 0; letter-spacing: 1px;
            text-shadow: 0 0 15px rgba(239,68,68,0.3);
        }

        /* ===== SOCIAL PROOF POPUP ===== */
        .social-proof {
            position: fixed; bottom: 24px; left: 24px; z-index: 9998;
            background: var(--surface2); border: 1px solid var(--border);
            backdrop-filter: blur(20px);
            border-radius: 14px; padding: 14px 18px;
            display: flex; align-items: center; gap: 12px;
            max-width: 320px;
            transform: translateX(-120%); opacity: 0;
            transition: all 0.5s cubic-bezier(0.16,1,0.3,1);
            box-shadow: 0 16px 50px rgba(0,0,0,0.5);
        }
        .social-proof.show { transform: translateX(0); opacity: 1; }
        .sp-avatar {
            width: 36px; height: 36px; border-radius: 10px;
            background: linear-gradient(135deg, var(--accent), var(--cyan));
            display: flex; align-items: center; justify-content: center;
            font-weight: 800; font-size: 0.8rem; color: #fff; flex-shrink: 0;
        }
        .sp-text { font-size: 0.75rem; color: var(--text2); line-height: 1.4; }
        .sp-name { font-weight: 700; color: var(--text); }
        .sp-time { font-size: 0.65rem; color: var(--text3); margin-top: 2px; }

        /* ===== TRUST BADGES ===== */
        .trust-row {
            display: flex; justify-content: center; gap: 16px;
            margin-top: 20px; flex-wrap: wrap;
        }
        .trust-badge {
            display: flex; align-items: center; gap: 6px;
            background: var(--surface); border: 1px solid var(--border);
            border-radius: 10px; padding: 8px 14px;
            font-size: 0.68rem; color: var(--text2); font-weight: 500;
        }
        .trust-badge svg { width: 14px; height: 14px; stroke: var(--green); fill: none; stroke-width: 2; }

        /* ===== SLOTS REMAINING ===== */
        .slots-bar {
            margin-top: 10px; padding: 0 4px;
        }
        .slots-track {
            height: 4px; background: rgba(255,255,255,0.04);
            border-radius: 4px; overflow: hidden; margin-bottom: 6px;
        }
        .slots-fill {
            height: 100%; border-radius: 4px;
            background: linear-gradient(90deg, var(--green), var(--gold), #ef4444);
            width: 78%;
            animation: slotPulse 2s ease infinite;
        }
        @keyframes slotPulse {
            0%,100% { opacity: 1; } 50% { opacity: 0.7; }
        }
        .slots-text {
            font-size: 0.7rem; color: var(--text3);
            display: flex; justify-content: space-between;
        }
        .slots-text .warn { color: #ef4444; font-weight: 600; }

        /* ===== SECTION ===== */
        .section {
            margin-top: 32px;
        }
        .section-label {
            display: flex; align-items: center; gap: 8px;
            font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
            letter-spacing: 2.5px; color: var(--text2);
            margin-bottom: 14px; padding-left: 4px;
        }

        /* ===== TIER CARDS ===== */
        .tier-list { display: flex; flex-direction: column; gap: 10px; }

        .tier {
            background: var(--surface);
            border: 1.5px solid var(--border);
            border-radius: 16px;
            padding: 22px 24px;
            display: flex; align-items: center; gap: 16px;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.16,1,0.3,1);
            position: relative;
            overflow: hidden;
        }
        .tier::before {
            content: ''; position: absolute; inset: 0;
            background: linear-gradient(135deg, rgba(139,92,246,0.04), transparent);
            opacity: 0; transition: opacity 0.3s;
        }
        .tier:hover { border-color: var(--border-h); transform: translateY(-2px); }
        .tier:hover::before { opacity: 1; }
        .tier.selected {
            border-color: var(--accent);
            background: linear-gradient(160deg, rgba(139,92,246,0.08), var(--surface));
            box-shadow: 0 0 30px rgba(139,92,246,0.08), inset 0 1px 0 rgba(139,92,246,0.15);
        }
        .tier.selected::before { opacity: 1; }

        /* Radio */
        .tier-radio {
            width: 20px; height: 20px; border-radius: 50%;
            border: 2px solid var(--text3);
            display: flex; align-items: center; justify-content: center;
            flex-shrink: 0; transition: all 0.3s;
        }
        .tier-radio::after {
            content: ''; width: 8px; height: 8px; border-radius: 50%;
            background: var(--accent); transform: scale(0);
            transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1);
        }
        .tier.selected .tier-radio { border-color: var(--accent); }
        .tier.selected .tier-radio::after { transform: scale(1); }

        .tier-info { flex: 1; min-width: 0; }
        .tier-name-row {
            display: flex; align-items: center; gap: 8px;
            margin-bottom: 3px;
        }
        .tier-icon { font-size: 0.95rem; }
        .tier-name { font-weight: 700; font-size: 0.95rem; letter-spacing: -0.3px; }
        .tier-badge {
            font-size: 0.55rem; font-weight: 800; text-transform: uppercase;
            letter-spacing: 1.5px; padding: 2px 8px; border-radius: 6px;
        }
        .badge-popular { background: rgba(34,211,238,0.15); color: var(--cyan); }
        .badge-lifetime { background: rgba(251,191,36,0.15); color: var(--gold); }
        .tier-desc {
            font-size: 0.78rem; color: var(--text2); font-weight: 400;
        }

        .tier-price { text-align: right; flex-shrink: 0; }
        .tier-amount {
            font-family: 'JetBrains Mono', monospace;
            font-size: 1.05rem; font-weight: 700; color: var(--green);
            letter-spacing: -0.5px;
        }
        .tier-period {
            font-size: 0.7rem; color: var(--text3); text-align: right;
            margin-top: 1px;
        }

        /* ===== FEATURE PEEK ===== */
        .features-peek {
            overflow: hidden;
            max-height: 0;
            transition: max-height 0.5s cubic-bezier(0.16,1,0.3,1), margin 0.5s;
            margin-top: 0;
        }
        .features-peek.open {
            max-height: 400px;
            margin-top: 16px;
        }
        .features-inner {
            display: grid; grid-template-columns: 1fr 1fr; gap: 6px 16px;
            padding: 16px 20px;
            background: rgba(0,0,0,0.25);
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.03);
        }
        .feat {
            display: flex; align-items: center; gap: 7px;
            font-size: 0.78rem; color: var(--text2); padding: 4px 0;
        }
        .feat-dot {
            width: 4px; height: 4px; border-radius: 50%;
            background: var(--accent2); flex-shrink: 0;
        }
        .feat.disabled { color: var(--text3); }
        .feat.disabled .feat-dot { background: var(--text3); opacity: 0.4; }

        /* ===== QRIS SECTION ===== */
        .qris-section {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 28px;
        }
        .qris-content {
            display: flex; flex-direction: column; align-items: center; gap: 20px;
            text-align: center;
        }
        .qris-code {
            width: 100%; max-width: 420px; border-radius: 16px;
            background: #fff; flex-shrink: 0;
            display: flex; align-items: center; justify-content: center;
            padding: 8px;
            box-shadow: 0 0 40px rgba(139,92,246,0.1);
            overflow: hidden;
            cursor: pointer;
            transition: all 0.3s;
            position: relative;
        }
        .qris-code:hover {
            transform: scale(1.02);
            box-shadow: 0 0 50px rgba(139,92,246,0.2);
        }
        .qris-code img {
            width: 100%; height: auto; display: block;
            border-radius: 10px;
        }
        .qris-code .dl-overlay {
            position: absolute; inset: 0;
            background: rgba(0,0,0,0.5);
            display: flex; flex-direction: column;
            align-items: center; justify-content: center; gap: 8px;
            opacity: 0; transition: opacity 0.3s;
            border-radius: 16px;
        }
        .qris-code:hover .dl-overlay { opacity: 1; }
        .dl-overlay svg { width: 36px; height: 36px; stroke: #fff; fill: none; stroke-width: 2; }
        .dl-overlay span {
            color: #fff; font-size: 0.8rem; font-weight: 700;
            background: rgba(139,92,246,0.8); padding: 6px 18px;
            border-radius: 8px;
        }
        .qris-text { text-align: center; }
        .qris-text h4 { font-size: 0.95rem; font-weight: 700; margin-bottom: 6px; letter-spacing: -0.3px; }
        .qris-text p { font-size: 0.8rem; color: var(--text2); line-height: 1.6; margin-bottom: 12px; }
        .qris-dl-btn {
            display: inline-flex; align-items: center; gap: 8px;
            background: linear-gradient(135deg, var(--accent), #7c3aed);
            color: #fff; padding: 10px 22px; border-radius: 10px;
            font-size: 0.8rem; font-weight: 700; border: none;
            cursor: pointer; transition: all 0.3s; margin-bottom: 14px;
            font-family: 'Inter', sans-serif;
        }
        .qris-dl-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(139,92,246,0.3);
        }
        .qris-dl-btn svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2; }
