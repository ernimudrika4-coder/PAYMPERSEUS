<script>
// 3D Tilt effect on hero card
const heroCard = document.querySelector('.hero-card');
heroCard.addEventListener('mousemove', e => {
    const rect = heroCard.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;
    const centerX = rect.width / 2;
    const centerY = rect.height / 2;
    const rotateX = ((y - centerY) / centerY) * -4;
    const rotateY = ((x - centerX) / centerX) * 4;
    heroCard.style.transform = `perspective(800px) rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
    heroCard.style.transition = 'transform 0.1s ease';
});
heroCard.addEventListener('mouseleave', () => {
    heroCard.style.transform = 'perspective(800px) rotateX(0) rotateY(0)';
    heroCard.style.transition = 'transform 0.5s ease';
});

let selectedTier = null;
let selectedPrice = 0;
let selectedPeriod = '';
let agreed = false;
let discount = 0;

function selectTier(el, name, price, period) {
    // Deselect all
    document.querySelectorAll('.tier').forEach(t => t.classList.remove('selected'));
    document.querySelectorAll('.features-peek').forEach(f => f.classList.remove('open'));

    // Select this
    el.classList.add('selected');
    const featId = 'feat-' + el.dataset.features;
    const featEl = document.getElementById(featId);
    if (featEl) featEl.classList.add('open');

    selectedTier = name;
    selectedPrice = price;
    selectedPeriod = period;

    // Update summary
    document.getElementById('sumName').textContent = name;
    document.getElementById('sumPeriod').textContent = period === 'lifetime' ? 'Lifetime' : 'Bulanan';
    updateSummary();
    document.getElementById('summary').classList.add('open');

    updateCTA();
}

function updateSummary() {
    const discountAmt = Math.floor(selectedPrice * discount);
    const total = selectedPrice - discountAmt;
    document.getElementById('sumDiscount').textContent = discount > 0 ? '-Rp ' + discountAmt.toLocaleString('id-ID') : '—';
    document.getElementById('sumTotal').textContent = 'Rp ' + total.toLocaleString('id-ID');
}

function toggleAgree() {
    agreed = !agreed;
    document.getElementById('agreeBox').classList.toggle('checked', agreed);
    updateCTA();
}

function updateCTA() {
    document.getElementById('ctaBtn').disabled = !(selectedTier && agreed);
}

function applyVoucher() {
    const code = document.getElementById('voucherInput').value.trim().toUpperCase();
    if (!code) return;

    // Demo voucher logic
    if (code === 'PERSEUS10') {
        discount = 0.10;
        showToast('🎉 Voucher 10% applied!');
    } else if (code === 'ALPHA20') {
        discount = 0.20;
        showToast('🎉 Voucher 20% applied!');
    } else {
        discount = 0;
        showToast('✗ Kode voucher tidak valid');
    }

    if (selectedTier) updateSummary();
}

function downloadQris() {
    const img = document.querySelector('.qris-code img');
    const a = document.createElement('a');
    a.href = img.src;
    a.download = 'QRIS-Perseus-Trade.jpg';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    showToast('📥 QRIS berhasil didownload!');
}

function confirmPayment() {
    if (!selectedTier || !agreed) return;
    const total = selectedPrice - Math.floor(selectedPrice * discount);
    const msg = `Halo, saya ingin mengaktifkan ${selectedTier} (Rp ${total.toLocaleString('id-ID')}). Berikut bukti transfer saya:`;
    window.open('https://t.me/pers3oF?text=' + encodeURIComponent(msg), '_blank');
}

function showToast(msg) {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 2500);
}

// ===== COUNTDOWN TIMER =====
(function() {
    let totalSec = 2*3600 + 59*60 + 47;
    const el = document.getElementById('countdown');
    setInterval(() => {
        if (totalSec <= 0) totalSec = 3*3600;
        totalSec--;
        const h = String(Math.floor(totalSec/3600)).padStart(2,'0');
        const m = String(Math.floor((totalSec%3600)/60)).padStart(2,'0');
        const s = String(totalSec%60).padStart(2,'0');
        el.textContent = h+':'+m+':'+s;
    }, 1000);
})();

// ===== LIVE VIEWER COUNT =====
(function() {
    const el = document.getElementById('liveCount');
    let base = 18 + Math.floor(Math.random()*10);
    el.textContent = base;
    setInterval(() => {
        base += Math.random()>0.5 ? 1 : -1;
        base = Math.max(12, Math.min(38, base));
        el.textContent = base;
    }, 4000);
})();

